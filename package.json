{
  "name": "scanreq",
  "displayName": "ScanReq",
  "description": "Real-time security scanner for Python, Node.js, Rust, Go, PHP, Ruby and Java (Maven & Gradle) dependencies. Detects outdated packages and CVE vulnerabilities directly in VS Code.",
  "version": "2.6.5",
  "publisher": "trustdev",
  "author": {
    "name": "TrustDev"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://scanreq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/JorgeCedilloAbarca/scanreq"
  },
  "bugs": {
    "url": "https://github.com/JorgeCedilloAbarca/scanreq/issues"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "python",
    "nodejs",
    "javascript",
    "rust",
    "go",
    "golang",
    "php",
    "ruby",
    "java",
    "maven",
    "gradle",
    "kotlin",
    "android",
    "composer",
    "gemfile",
    "pom.xml",
    "build.gradle",
    "maven-central",
    "packagist",
    "rubygems",
    "security",
    "dependencies",
    "vulnerabilities",
    "CVE",
    "requirements",
    "package.json",
    "Cargo.toml",
    "go.mod",
    "pip",
    "npm",
    "crates",
    "PyPI",
    "audit",
    "scanner"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scanreq.scan",
        "title": "ScanReq: Analizar dependencias / Scan dependencies"
      },
      {
        "command": "scanreq.activateLicense",
        "title": "ScanReq: Activate Pro Plan"
      },
      {
        "command": "scanreq.deactivateLicense",
        "title": "ScanReq: Deactivate Pro Plan"
      }
    ],
    "configuration": {
      "title": "ScanReq",
      "properties": {
        "scanreq.autoOpenPanel": {
          "type": "boolean",
          "default": false,
          "description": "Abrir el panel automáticamente al iniciar VS Code o al detectar cambios en archivos de dependencias. / Automatically open the panel on VS Code startup or when changes are detected in dependency files."
        },
        "scanreq.showNotification": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar notificación de progreso mientras se analizan las dependencias. / Show progress notification while dependencies are being analyzed."
        },
        "scanreq.excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns for paths to exclude from dependency scanning. Examples: \"src/functionalTest\", \"**/test/resources\", \"**/fixtures\". No defaults — configure to match your project structure. / Patrones glob para excluir rutas del escaneo. Ejemplos: \"src/functionalTest\", \"**/test/resources\". Sin valores por defecto — configura según tu proyecto."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4"
  }
}